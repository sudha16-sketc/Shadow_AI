# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# Used by docker-compose.yml on the host.

# ── Required ────────────────────────────────────────────────────────────────
# 48+ bytes of non-trivial random material. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Backend container Mongo connection string.
# Local:  mongodb://mongo:27017/shadow-ai-auditor
# Atlas:  mongodb+srv://user:password@cluster/...
MONGODB_URI=mongodb://mongo:27017/shadow-ai-auditor

# Browser-visible backend origin. Must match the value passed to the frontend
# build (VITE_API_URL); it is used for CORS and for the CSP connect-src list.
VITE_API_URL=http://localhost:3001

# Origins allowed to call the API with credentials (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Bootstrap (one-time) ────────────────────────────────────────────────────
# Used by: cd backend && npm run provision:platform-admin
# Must be provided at run time (env vars), not stored here. Password >= 16 chars.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Optional alerting ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=shadow-ai@example.com

# Dashboard origin referenced by the extension popup "Open Dashboard" button.
FRONTEND_URL=http://localhost:5173
