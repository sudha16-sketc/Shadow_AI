# Copy to backend/.env (git-ignored) for local development.
# Values here are placeholders only — never put real credentials in this file.

NODE_ENV=development
PORT=3001

# Required. 48+ bytes of non-trivial random material, no fallback default:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Local: mongodb://localhost:27017/shadow-ai-auditor
# Atlas: mongodb+srv://user:password@cluster/...
MONGODB_URI=mongodb://localhost:27017/shadow-ai-auditor

# Comma-separated origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Upstream AI provider timeout in milliseconds (gateway).
GATEWAY_TIMEOUT_MS=60000

# Maximum time in-flight requests are drained on SIGTERM/SIGINT.
SHUTDOWN_GRACE_MS=15000

# Upper bound on rows returned by GET /api/audit-log/export.
AUDIT_EXPORT_MAX_ROWS=10000

# trace | debug | info | warn | error
LOG_LEVEL=info

# Origin used in alert links.
FRONTEND_URL=http://localhost:5173

# Optional SMTP alerting (leave blank to disable email alerts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=shadow-ai@example.com

# Optional one-time platform administrator bootstrap:
#   npm run provision:platform-admin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
